user www-data;
# containers see ALL host CPUs: 'auto' would start dozens of workers and eat the RAM -> 2 is the sweet spot
worker_processes 2;
worker_rlimit_nofile 65535;
pid /run/nginx.pid;
events { worker_connections 8192; multi_accept on; }
http {
  access_log off;
  error_log /dev/stderr warn;
  sendfile on; tcp_nodelay on; keepalive_timeout 75s;
  client_max_body_size 0;
  map $http_upgrade $conn_upgrade { default upgrade; '' ''; }

  # performance: reuse connections to the panel, compress panel assets
  upstream panel { server 127.0.0.1:8000; keepalive 32; }
  gzip on; gzip_comp_level 5; gzip_min_length 1024; gzip_proxied any;
  gzip_types text/css application/javascript application/json image/svg+xml text/plain;

  server {
    listen __PORT__ default_server;

    location = /healthz { return 200 "ok"; }

    # ---- 5 config paths: random per install, generated by genpaths.py on first boot ----
    include /var/lib/pasarguard/inbounds.inc;

    # ---- owner key page (get a 5-minute key to change the owner password) ----
    location ^~ /jinx/ {
      proxy_pass http://127.0.0.1:8100;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header Host $host;
    }

    # ---- Super JinX dashboard menu filter ----
    location = /jinx-ui.js { alias /etc/nginx/jinx-ui.js; default_type application/javascript; add_header Cache-Control "no-cache"; }
    location /dashboard {
      proxy_pass http://panel;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header Connection "";
      proxy_set_header Accept-Encoding "";
      sub_filter_types text/html;
      sub_filter_once on;
      sub_filter '</head>' '<script src="/jinx-ui.js" defer></script></head>';
    }

    # ---- protected: groups, hosts, cores, nodes and roles can be READ from the dashboard but never
    #      deleted or changed from outside (only the built-in setup inside the server can change them) ----
    location ~ ^/api/(groups?|hosts?|cores?|nodes?|admin-roles?)(/|$)(?!.*bulk) {
      limit_except GET HEAD { deny all; }   # bulk actions on users (add/remove group) still work
      proxy_pass http://panel;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header Connection "";
    }

    # ---- subscription links: short timeouts; if the panel is restarting for a moment, apps get
    #      503 + Retry-After (they keep their old configs) and browsers see a page that reloads by itself ----
    location ^~ /sub/ {
      proxy_pass http://panel;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header Connection "";
      proxy_connect_timeout 3s;
      proxy_read_timeout 30s;
      proxy_intercept_errors on;
      error_page 500 502 503 504 = @subwait;
    }
    location @subwait {
      default_type text/html;
      charset utf-8;
      add_header Retry-After 3 always;
      add_header Cache-Control "no-store" always;
      return 503 '<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="refresh" content="3"><title>Super JinX</title><style>body{margin:0;min-height:100vh;display:grid;place-items:center;background:#05060c;color:#f5f7ff;font-family:Vazirmatn,Tahoma,system-ui,sans-serif;text-align:center}i{display:block;width:46px;height:46px;margin:0 auto 18px;border-radius:50%;border:3px solid rgba(255,255,255,.12);border-top-color:#818cf8;animation:s 1s linear infinite}@keyframes s{to{transform:rotate(360deg)}}small{color:#949cb8}</style></head><body><div><i></i><b>Super JinX</b><p>در حال آماده شدن، چند ثانیه صبر کن...</p><small>Getting ready, this page reloads by itself</small></div></body></html>';
    }

    # ---- panel / api / subscription ----
    location / {
      proxy_pass http://panel;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $conn_upgrade;
      proxy_read_timeout 300s;
    }
  }
}
